# Copy to .env and fill in your values:
#   cp .env.example .env

SECRET_KEY=change-me
DEBUG=True

# ——— Real OTP email (required for inbox delivery) ———
# Gmail: enable 2FA → App passwords → https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=TableTop <your.email@gmail.com>

# Optional: show OTP in API response (dev only, insecure)
OTP_SHOW_IN_API=false

# Database (MySQL) — local defaults used if unset
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=restaurant_db
# DB_USER=root
# DB_PASSWORD=newpassword
# DB_SSL=false

